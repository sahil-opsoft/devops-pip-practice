#!/usr/bin/env bash
# Block the commit if any staged shell script has a syntax error.
status=0
while IFS= read -r file; do
  if ! git show ":$file" | bash -n; then
    echo "pre-commit: syntax error in $file" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.sh')
if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit blocked. Fix the errors and try again." >&2
fi
exit "$status"
